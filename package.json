{
  "name": "archer-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "build:cloudflare": "vite build --mode cloudflare --outDir dist-cloudflare",
    "dev:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy:cloudflare": "wrangler deploy",
    "test:cloudflare": "node tests/cloudflare.smoke.js",
    "test:cloudflare:browser": "node tests/cloudflare.browser.js",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "tsc --noEmit",
    "test:browser": "node tests/browser.smoke.js",
    "test:audio": "node tests/audio.smoke.js",
    "test:powerups": "node tests/powerups.smoke.js",
    "test:bow-buffs": "node tests/bow-buffs.browser.js",
    "test:interaction": "node tests/interaction.smoke.js",
    "test:motion": "node tests/motion.browser.js",
    "test:projectiles": "node tests/projectiles.browser.js",
    "test:forest": "node tests/forest.browser.js",
    "test:community": "node tests/community.browser.js",
    "test:community:runtime": "node tests/community.smoke.js",
    "test:network": "node tests/network.smoke.js",
    "test:live": "node tests/live.smoke.js",
    "test:hud": "node tests/hud.smoke.js",
    "test:lobby": "node tests/lobby.browser.js",
    "test:expansion": "node tests/expansion.browser.js",
    "test:performance": "node tests/performance.browser.js",
    "test:conformance": "node --test tests/protocol-conformance.test.js tests/safe-traces.test.js",
    "bench:safe": "node --expose-gc benchmarks/safe-optimizations.js",
    "test:multimode": "node tests/multimode.smoke.js",
    "test:profile": "node tests/profile.browser.js",
    "test:kill-streak": "node tests/kill-streak.browser.js",
    "test:join": "node tests/join.browser.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.2.13",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
