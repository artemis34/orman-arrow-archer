{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orman-arrow-archer",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "build": {
    "command": "npm run build:cloudflare",
    "watch_dir": ["client", "shared", "public", "index.html", "vite.config.js"],
  },
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ARENAS", "class_name": "ArenaRoom" },
      { "name": "MATCHMAKER", "class_name": "ArenaMatchmaker" },
      { "name": "PROFILES", "class_name": "PlayerProfile" },
      { "name": "COMMUNITY", "class_name": "CommunityHub" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArenaRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ArenaMatchmaker"] },
    { "tag": "v3", "new_sqlite_classes": ["PlayerProfile"] },
    { "tag": "v4", "new_sqlite_classes": ["CommunityHub"] },
  ],
}
